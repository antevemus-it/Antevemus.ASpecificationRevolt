{
  "name": "antevemus/aspecification-revolt",
  "description": "Revolt/Fibers satellite of antevemus/aspecification: RevoltDataSource and RevoltStageTransport fetch the non-HTTP external data of a resolution stage concurrently under the Revolt event loop (Fibers, Amp futures), through the IDeferredDataSource/IStageTransport hook of the core, with a concurrency limit, per-source time limits and the resolution deadline",
  "type": "library",
  "license": "MIT",
  "homepage": "https://github.com/antevemus-it/Antevemus.ASpecificationRevolt",
  "support": {
    "source": "https://github.com/antevemus-it/Antevemus.ASpecificationRevolt",
    "issues": "https://github.com/antevemus-it/Antevemus.ASpecificationRevolt/issues",
    "docs": "https://github.com/antevemus-it/Antevemus.ASpecificationRevolt#readme"
  },
  "keywords": [
    "specification",
    "specification-pattern",
    "data-resolution",
    "async",
    "fiber",
    "revolt",
    "amphp",
    "event-loop",
    "concurrency",
    "php82"
  ],
  "authors": [
    {
      "name": "Heliton Junior - CTO @ Antevemus Soluções Inovadoras em TI Ltda.",
      "email": "contato@antevemus.com.br",
      "homepage": "https://antevemus.com.br"
    }
  ],
  "require": {
    "php": "^8.2",
    "antevemus/aspecification": "^2.6",
    "revolt/event-loop": "^1.0",
    "amphp/amp": "^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "amphp/http-server": "^3.4",
    "amphp/http-client": "^5.3",
    "infection/infection": "^0.31.9 || ^0.35.6"
  },
  "autoload": {
    "psr-4": {
      "Antevemus\\ASpecificationRevolt\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Antevemus\\ASpecificationRevolt\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "infection/extension-installer": false
    }
  }
}
